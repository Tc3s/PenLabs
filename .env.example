# PenLabs — Environment Variables
# Copy file này thành .env và điền các giá trị thực

# === API KEYS ===
VT_API_KEY=
SHODAN_KEY=
CHAOS_KEY=
SECURITYTRAILS_KEY=

# === TIMEOUTS (giây) ===
MSF_TIMEOUT=300
NMAP_TIMEOUT=600
HTTP_TIMEOUT=15

# === PERFORMANCE BUDGETS ===
# Override khi cần tinh chỉnh tốc độ/noise theo RoE. Mặc định đã được set theo mode.
# PENLABS_FFUF_TARGETS=5
# PENLABS_FFUF_CONCURRENCY=2
# PENLABS_FFUF_THREADS=10
# PENLABS_FFUF_RATE=150
# PENLABS_FFUF_TIMEOUT=300
# PENLABS_CRAWLER_CONCURRENCY=2
# PENLABS_KITERUNNER_TARGETS=30
# PENLABS_NMAP_MSF_SYNC=false
# MSF_CONNECT_TIMEOUT=3

# === PATHS ===
# VULN_DB_PATH=data/vuln_db.json
# PROXY_FILE=proxies.txt
# BLACKLIST_FILE=blacklist.txt

# === [V1.0] VISUAL RECON & PERSISTENCE ===
# VISUAL_RECON=false
# PERSISTENCE=false
# CLOUDFLARE_TUNNEL_ENABLED=true             # Bật C2 Web UI / HTTP Reports
# GOWITNESS_TIMEOUT=15
# GOWITNESS_THREADS=4
# C2_LHOST=              # IP máy nhận callback (reverse shell)
# C2_LPORT=4444          # Port nhận callback

# === [V1.0] STEALTH & PRECISION ENGINE ===
# OBFUSCATOR_ENCODING_ITERATIONS=3           # Số vòng encode mỗi encoder
# OBFUSCATOR_ENCODERS=x86/shikata_ga_nai,x86/xor,x86/countdown
# EDR_DRYRUN_ENABLED=true                    # TCP probe trước khi exploit
# EDR_DRYRUN_TIMEOUT=3.0                     # Timeout probe (giây)
# INTERACTSH_ENABLED=true                    # Chạy interactsh-client nền
# INTERACTSH_TIMEOUT=15                      # Timeout lấy OOB URL
# SMART_CPE_FILTER=true                      # Cross-validate Nmap CPE vs HttpX
